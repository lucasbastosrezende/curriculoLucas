{
	admin off

	servers {
		# Slowloris / oversized-header protection for a static site.
		timeouts {
			read_header 10s
			read_body 10s
			write 30s
			idle 2m
		}
		max_header_size 16KB
	}
}

{$DOMAIN}:8444 {
	tls {
		dns duckdns {env.DUCKDNS_TOKEN}
		protocols tls1.2 tls1.3
	}

	# Static site: nothing accepts a body, and only GET/HEAD make sense.
	request_body {
		max_size 1KB
	}
	@badmethod not method GET HEAD
	respond @badmethod 405 {
		close
	}

	root * /srv
	encode zstd gzip
	file_server

	# Hide dotfiles
	@hidden path /.* */.*
	respond @hidden 404

	@static path /vendor/* /fonts/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	@html path / /index.html
	header @html Cache-Control "no-cache"

	# The design runtime (support.js) compiles the page logic with `new Function`, hence 'unsafe-eval'.
	# Scripts and fonts load only from this origin; fetches only go to the two GitHub data sources the page uses.
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		X-Permitted-Cross-Domain-Policies "none"
		Content-Security-Policy "default-src 'none'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src https://api.github.com https://github-contributions-api.jogruber.de; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'; manifest-src 'self'; upgrade-insecure-requests"
		-Server
	}

	log {
		output stdout
		format console
	}
}
